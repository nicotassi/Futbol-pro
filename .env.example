# =============================================================================
# FRONTEND (.env.local) — solo variables PÚBLICAS con prefijo VITE_.
# =============================================================================
# Supabase → Project Settings → API Keys.
# La clave publicable ("anon") es pública por diseño: la seguridad la da RLS.
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# SERVIDOR (.env.server.local) — NUNCA en el frontend ni en el repositorio.
# Solo lo usa `npm run family` en la computadora de papá.
# =============================================================================
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SECRET_KEY=

# Fase 5 (secretos de Supabase, no de este archivo):
#   supabase secrets set ANTHROPIC_API_KEY=...  WATCH_AI_MODEL=claude-opus-5-5
