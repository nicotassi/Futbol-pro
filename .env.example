# Variables PÚBLICAS del frontend (prefijo VITE_). Nunca poner claves privadas acá.
# Copiar a .env.local y completar.

# Fase 2 — Supabase (la "anon key" es pública por diseño; la seguridad la da RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Las claves privadas (p. ej. ANTHROPIC_API_KEY) se cargan como secretos de Supabase,
# nunca en este archivo ni en el frontend.
